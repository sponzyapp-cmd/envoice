{
  "name": "envoice",
  "version": "1.0.0",
  "private": false,
  "description": "Envoice — single Cloudflare Worker that serves the Envoice HTML app and stores users, published envoices and submissions in D1.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create envoice-db",
    "db:migrate:local": "wrangler d1 migrations apply envoice-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply envoice-db --remote"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "license": "MIT"
}
